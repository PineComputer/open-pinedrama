# Copy to .env.local and fill in. Without a key the studio runs in replay mode:
# recorded turns and placeholder media, no Pine project and no spend.

# Your Pine project's endpoint and API key, from the console: Project → API keys.
# PINE_SANDBOX_ENDPOINT=https://pinesandbox.io
# PINE_SANDBOX_API_KEY=pk_...

# Optional: where the studio keeps its records, library and sealing key (default .data/).
# STUDIO_DATA_DIR=

# Optional: the engine's port on 127.0.0.1 (default 4310).
# STUDIO_PORT=4310

# Optional: force a mode, "pine" or "replay" (default: pine when a key is set).
# STUDIO_MODE=
