{
  "name": "open-pinedrama",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "A studio for makers of AI vertical short dramas, built on Pine Computer.",
  "main": "dist/desktop/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "engine": "tsx src/engine/main.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/engine/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "e2e": "node scripts/e2e-build.mjs && playwright test",
    "pine:check": "tsx scripts/pine-check.ts",
    "desktop": "node scripts/desktop.mjs && electron .",
    "package": "node scripts/desktop.mjs && electron-builder --config electron-builder.config.mjs",
    "design": "vite design --host 127.0.0.1 --port 5180 --strictPort",
    "design:diff": "playwright test --config playwright.design.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@hono/node-server": "^2.1.5",
    "@phosphor-icons/react": "2.1.10",
    "@pinesandbox/computer": "^0.3.4",
    "@pinesandbox/computer-web": "^0.3.8",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.44",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "12.12.0",
    "@xzdarcy/react-timeline-editor": "1.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "date-fns": "4.4.0",
    "diff": "9.0.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "electron-updater": "6.8.10",
    "elkjs": "0.12.0",
    "esbuild": "0.28.2",
    "fountain-js": "1.2.4",
    "hono": "^4.13.13",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.1.3",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "media-chrome": "4.19.4",
    "msw": "^3.0.3",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "20.1.3",
    "react-json-view-lite": "2.5.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "srt-parser-2": "1.2.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wavesurfer.js": "8.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
