{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["dom", "dom.iterable", "ES2023", "ES2025.Intl"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./src/ui/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "desktop/**/*.ts", "scripts/**/*.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
